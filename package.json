    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "version": "node scripts/sync-version.mjs && git add server.json plugin CHANGELOG.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "author": "Daniel Machado",
  "mcpName": "io.github.DanielDDHM/become-human",
  "homepage": "https://github.com/201Tech/become-human#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/201Tech/become-human.git"
  },
  "bugs": {
    "url": "https://github.com/201Tech/become-human/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agent",
