{
  "name": "become-human",
  "version": "0.6.1",
  "description": "MCP server that makes any agent work with and for humans",
  "license": "MIT",
  "bin": {
    "become-human": "dist/index.js"
  },
  "files": [
    "dist",
    "rules",
    "art/creation.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
